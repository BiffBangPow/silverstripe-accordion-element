{
  "name": "biffbangpow/silverstripe-accordion-element",
  "description": "Collapsible content accordion for Silverstripe",
  "type": "silverstripe-vendormodule",
  "minimum-stability": "dev",
  "license": "proprietary",
  "authors": [
    {
      "name": "Tim Burt",
      "email": "tim@biffbangpow.com"
    },
    {
      "name": "James Heathcote",
      "email": "james.h@biffbangpow.com"
    }
  ],
  "require": {
    "dnadesign/silverstripe-elemental": "*",
    "biffbangpow/silverstripe-sortable-extension": "dev-master",
    "silverstripe/linkfield": "^5"
  },
  "autoload": {
    "psr-4": {
      "BiffBangPow\\Element\\": "src/"
    }
  },
  "extra": {},
  "suggest": {
    "biffbangpow/silverstripe-element-spacing": "Optional element spacing controls in the CMS.",
    "dorsetdigital/silverstripe-schema-manager": "Output FAQPage structured data through a shared page-level JSON-LD graph instead of inline markup."
  }
}
